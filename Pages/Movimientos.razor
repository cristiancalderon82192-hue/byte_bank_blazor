@page "/movimientos"
@using ByteBank.Models
@inject CuentaService CuentaService
@inject MovimientoService MovimientoService
@inject SucursalService SucursalService
@inject CatalogoService CatalogoService

<PageTitle>Movimientos Bancarios</PageTitle>

<h1>Movimientos Bancarios</h1>

<div class="mb-3">
    <button class="btn btn-success me-2" @onclick="MostrarDeposito">
        <i class="bi bi-arrow-down-circle"></i> Depósito
    </button>
    <button class="btn btn-danger me-2" @onclick="MostrarRetiro">
        <i class="bi bi-arrow-up-circle"></i> Retiro
    </button>
    <button class="btn btn-primary" @onclick="MostrarTransferencia">
        <i class="bi bi-arrow-left-right"></i> Transferencia
    </button>
</div>

<div class="card mb-4">
    <div class="card-header">
        Filtros de Búsqueda
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Fecha</label>
                <InputDate class="form-control" @bind-Value="filtroFecha" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Sucursal</label>
                <select class="form-select" @bind="filtroSucursal">
                    <option value="0">Todas</option>
                    @if (sucursales != null)
                    {
                        foreach (var suc in sucursales)
                        {
                            <option value="@suc.IdSucursal">@suc.Nombre</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Cuenta (Número)</label>
                <InputText class="form-control" @bind-Value="filtroCuenta" placeholder="Número de cuenta..." />
            </div>
            <div class="col-md-3">
                <label class="form-label">Tipo Movimiento</label>
                <select class="form-select" @bind="filtroTipo">
                    <option value="0">Todos</option>
                    @if (tiposMovimiento != null)
                    {
                        foreach (var tipo in tiposMovimiento)
                        {
                            <option value="@tipo.IdTipoMovimiento">@tipo.Nombre</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12 text-end">
                <button class="btn btn-secondary me-2" @onclick="LimpiarFiltros">Limpiar</button>
                <button class="btn btn-primary" @onclick="FiltrarMovimientos">Filtrar</button>
            </div>
        </div>
    </div>
</div>

@if (mensaje != null)
{
    <div class="alert @(esError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
        @mensaje
        <button type="button" class="btn-close" @onclick="() => mensaje = null"></button>
    </div>
}

<h2 class="mt-4">Lista de Movimientos Realizados</h2>
<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Cuenta</th>
            <th>Sucursal</th>
            <th>Fecha</th>
            <th>Valor</th>
            <th>Tipo Movimiento</th>
            <th>Descripción</th>
        </tr>
    </thead>
    <tbody>
        @if (movimientosFiltrados == null)
        {
            <tr>
                <td colspan="7">Cargando movimientos...</td>
            </tr>
        }
        else if (!movimientosFiltrados.Any())
        {
            <tr>
                <td colspan="7">No hay movimientos registrados.</td>
            </tr>
        }
        else
        {
            @foreach (var mov in movimientosFiltrados)
            {
                <tr>
                    <td>@mov.IdMovimiento</td>
                    <td>@(cuentas?.FirstOrDefault(c => c.IdCuenta == mov.IdCuenta)?.Numero ?? mov.IdCuenta.ToString())</td>
                    <td>@(mov.IdSucursal.HasValue ? sucursales?.FirstOrDefault(s => s.IdSucursal == mov.IdSucursal)?.Nombre ?? "No Aplica" : "No Aplica")</td>
                    <td>@mov.Fecha.ToString("yyyy-MM-dd")</td>
                    <td>@mov.Valor.ToString("F2")</td>
                    <td>@(tiposMovimiento?.FirstOrDefault(t => t.IdTipoMovimiento == mov.IdTipoMovimiento)?.Nombre ?? mov.IdTipoMovimiento.ToString())</td>
                    <td>@mov.Descripcion</td>
                </tr>
            }
        }
    </tbody>
</table>

<!-- Modal Depósito -->
@if (mostrarDeposito)
{
    <div class="modal fade show" style="display: block; background-color: rgba(0,0,0,0.5);" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">Realizar Depósito</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModales"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@deposito" OnValidSubmit="RealizarDeposito">
                        <div class="mb-3">
                            <label>Cuenta:</label>
                            <InputSelect class="form-control" @bind-Value="deposito.IdCuenta">
                                <option value="0">Seleccionar...</option>
                                @if (cuentas != null)
                                {
                                    foreach (var cuenta in cuentas)
                                    {
                                        <option value="@cuenta.IdCuenta">@cuenta.Numero</option>
                                    }
                                }
                            </InputSelect>
                        </div>
                        <div class="mb-3">
                            <label>Sucursal:</label>
                            <InputSelect class="form-control" @bind-Value="deposito.IdSucursal">
                                <option value="0">Seleccionar...</option>
                                @if (sucursales != null)
                                {
                                    foreach (var sucursal in sucursales)
                                    {
                                        <option value="@sucursal.IdSucursal">@sucursal.Nombre</option>
                                    }
                                }
                            </InputSelect>
                        </div>
                        <div class="mb-3">
                            <label>Valor:</label>
                            <InputNumber class="form-control" @bind-Value="deposito.Valor" />
                        </div>
                        <div class="mb-3">
                            <label>Descripción:</label>
                            <InputText class="form-control" @bind-Value="deposito.Descripcion" />
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CerrarModales">Cancelar</button>
                            <button type="submit" class="btn btn-success">Realizar Depósito</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Retiro -->
@if (mostrarRetiro)
{
    <div class="modal fade show" style="display: block; background-color: rgba(0,0,0,0.5);" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Realizar Retiro</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModales"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@retiro" OnValidSubmit="RealizarRetiro">
                        <div class="mb-3">
                            <label>Cuenta:</label>
                            <InputSelect class="form-control" @bind-Value="retiro.IdCuenta">
                                <option value="0">Seleccionar...</option>
                                @if (cuentas != null)
                                {
                                    foreach (var cuenta in cuentas)
                                    {
                                        <option value="@cuenta.IdCuenta">@cuenta.Numero</option>
                                    }
                                }
                            </InputSelect>
                        </div>
                        <div class="mb-3">
                            <label>Sucursal:</label>
                            <InputSelect class="form-control" @bind-Value="retiro.IdSucursal">
                                <option value="0">Seleccionar...</option>
                                @if (sucursales != null)
                                {
                                    foreach (var sucursal in sucursales)
                                    {
                                        <option value="@sucursal.IdSucursal">@sucursal.Nombre</option>
                                    }
                                }
                            </InputSelect>
                        </div>
                        <div class="mb-3">
                            <label>Valor:</label>
                            <InputNumber class="form-control" @bind-Value="retiro.Valor" />
                        </div>
                        <div class="mb-3">
                            <label>Descripción:</label>
                            <InputText class="form-control" @bind-Value="retiro.Descripcion" />
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CerrarModales">Cancelar</button>
                            <button type="submit" class="btn btn-danger">Realizar Retiro</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Transferencia -->
@if (mostrarTransferencia)
{
    <div class="modal fade show" style="display: block; background-color: rgba(0,0,0,0.5);" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Realizar Transferencia</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModales"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@transferencia" OnValidSubmit="RealizarTransferencia">
                        <div class="mb-3">
                            <label>Cuenta Origen:</label>
                            <InputSelect class="form-control" @bind-Value="transferencia.IdCuentaOrigen">
                                <option value="0">Seleccionar...</option>
                                @if (cuentas != null)
                                {
                                    foreach (var cuenta in cuentas)
                                    {
                                        <option value="@cuenta.IdCuenta">@cuenta.Numero</option>
                                    }
                                }
                            </InputSelect>
                        </div>
                        <div class="mb-3">
                            <label>Cuenta Destino:</label>
                            <InputSelect class="form-control" @bind-Value="transferencia.IdCuentaDestino">
                                <option value="0">Seleccionar...</option>
                                @if (cuentas != null)
                                {
                                    foreach (var cuenta in cuentas)
                                    {
                                        <option value="@cuenta.IdCuenta">@cuenta.Numero</option>
                                    }
                                }
                            </InputSelect>
                        </div>
                        <div class="mb-3">
                            <label>Sucursal:</label>
                            <InputSelect class="form-control" @bind-Value="transferencia.IdSucursal">
                                <option value="0">Seleccionar...</option>
                                @if (sucursales != null)
                                {
                                    foreach (var sucursal in sucursales)
                                    {
                                        <option value="@sucursal.IdSucursal">@sucursal.Nombre</option>
                                    }
                                }
                            </InputSelect>
                        </div>
                        <div class="mb-3">
                            <label>Valor:</label>
                            <InputNumber class="form-control" @bind-Value="transferencia.Valor" />
                        </div>
                        <div class="mb-3">
                            <label>Descripción:</label>
                            <InputText class="form-control" @bind-Value="transferencia.Descripcion" />
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CerrarModales">Cancelar</button>
                            <button type="submit" class="btn btn-primary">Realizar Transferencia</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private DepositoCreate deposito = new();
    private RetiroCreate retiro = new();
    private TransferenciaCreate transferencia = new();
    private string? mensaje;
    private bool esError;

    private bool mostrarDeposito = false;
    private bool mostrarRetiro = false;
    private bool mostrarTransferencia = false;

    private List<Movimiento>? movimientos;
    private List<Movimiento>? movimientosFiltrados;
    private List<Cuenta>? cuentas;
    private List<Sucursal>? sucursales;
    private List<TipoMovimiento>? tiposMovimiento;

    // Campos para filtros
    private DateTime? filtroFecha;
    private int filtroSucursal = 0;
    private string filtroCuenta = string.Empty;
    private int filtroTipo = 0;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
        await CargarMovimientos();
    }

    private async Task CargarDatos()
    {
        try
        {
            cuentas = await CuentaService.GetCuentasAsync();
            sucursales = await SucursalService.GetSucursalesAsync();
            tiposMovimiento = await CatalogoService.GetTiposMovimientoAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar datos: {ex}");
        }
    }

    private async Task CargarMovimientos()
    {
        try
        {
            movimientos = await MovimientoService.GetMovimientosAsync();
            FiltrarMovimientos();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error detallado: {ex}");
        }
    }

    private void FiltrarMovimientos()
    {
        if (movimientos == null) return;

        var query = movimientos.AsEnumerable();

        if (filtroFecha.HasValue)
        {
            query = query.Where(m => m.Fecha.Date == filtroFecha.Value.Date);
        }

        if (filtroSucursal > 0)
        {
            query = query.Where(m => m.IdSucursal == filtroSucursal);
        }

        if (!string.IsNullOrWhiteSpace(filtroCuenta))
        {
            var cuentasIds = cuentas?
                .Where(c => c.Numero.Contains(filtroCuenta, StringComparison.OrdinalIgnoreCase))
                .Select(c => c.IdCuenta)
                .ToList();

            if (cuentasIds != null && cuentasIds.Any())
            {
                query = query.Where(m => cuentasIds.Contains(m.IdCuenta));
            }
            else
            {
                query = Enumerable.Empty<Movimiento>();
            }
        }

        if (filtroTipo > 0)
        {
            query = query.Where(m => m.IdTipoMovimiento == filtroTipo);
        }

        movimientosFiltrados = query.ToList();
        StateHasChanged();
    }

    private void LimpiarFiltros()
    {
        filtroFecha = null;
        filtroSucursal = 0;
        filtroCuenta = string.Empty;
        filtroTipo = 0;
        FiltrarMovimientos();
    }

    private void MostrarDeposito()
    {
        CerrarModales();
        deposito = new();
        mostrarDeposito = true;
        mensaje = null;
    }

    private void MostrarRetiro()
    {
        CerrarModales();
        retiro = new();
        mostrarRetiro = true;
        mensaje = null;
    }

    private void MostrarTransferencia()
    {
        CerrarModales();
        transferencia = new();
        mostrarTransferencia = true;
        mensaje = null;
    }

    private void CerrarModales()
    {
        mostrarDeposito = false;
        mostrarRetiro = false;
        mostrarTransferencia = false;
    }

    private async Task RealizarDeposito()
    {
        try
        {
            var resultado = await MovimientoService.RealizarDepositoAsync(deposito);
            if (resultado != null)
            {
                mensaje = $"Depósito realizado exitosamente. Movimiento ID: {resultado.IdMovimiento}";
                esError = false;
                CerrarModales();
                await CargarMovimientos();
            }
            else
            {
                mensaje = "Error al realizar el depósito";
                esError = true;
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
            esError = true;
        }
    }

    private async Task RealizarRetiro()
    {
        try
        {
            var resultado = await MovimientoService.RealizarRetiroAsync(retiro);
            if (resultado != null)
            {
                mensaje = $"Retiro realizado exitosamente. Movimiento ID: {resultado.IdMovimiento}";
                esError = false;
                CerrarModales();
                await CargarMovimientos();
            }
            else
            {
                mensaje = "Error al realizar el retiro";
                esError = true;
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
            esError = true;
        }
    }

    private async Task RealizarTransferencia()
    {
        try
        {
            var resultado = await MovimientoService.RealizarTransferenciaAsync(transferencia);
            if (resultado != null)
            {
                mensaje = "Transferencia realizada exitosamente";
                esError = false;
                CerrarModales();
                await CargarMovimientos();
            }
            else
            {
                mensaje = "Error al realizar la transferencia";
                esError = true;
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
            esError = true;
        }
    }
}